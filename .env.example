# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-vision"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Required for Supabase Auth and Database RLS.
VITE_SUPABASE_URL="https://jiiyrenhkpyrvgymfnen.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_UIFCHRBc7B5we08dgDBkUw_0POzbO-w"

# NAVIGATION BACKEND: FastAPI service URL for NetworkX routing and CV detection.
VITE_NAVIGATION_BACKEND_URL="http://localhost:8000"
VITE_NAVIGATION_API_URL="http://localhost:8000"
